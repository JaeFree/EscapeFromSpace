    _count: 1
  _prologue: "\uADA4\uB3C4 \uC5F0\uAD6C \uC815\uAC70\uC7A5 \uC624\uB974\uBE44\uC2A4-9.\n\uC11D
    \uB2EC \uC804 \uC5F0\uB77D\uC774 \uB04A\uAE34 \uB4A4\uB85C, \uC544\uBB34\uB3C4
    \uC774\uACF3\uC5D0 \uC624\uC9C0 \uC54A\uC558\uB2E4.\n\n\uD68C\uC218 \uC5C5\uC790\uC778
    \uB2F9\uC2E0\uC740 \uAC12\uB098\uAC00\uB294 \uD654\uBB3C\uC744 \uB178\uB9AC\uACE0
    \uB3C4\uD0B9\uC744 \uC2DC\uB3C4\uD588\uB2E4.\n\uADF8 \uC21C\uAC04, \uC815\uAC70\uC7A5\uC758
    \uBCF4\uC548 AI '\uC13C\uD2F0\uB110'\uC774 \uD68C\uC218\uC120\uC744 \uD5A5\uD574
    \uD3EC\uBB38\uC744 \uC5F4\uC5C8\uB2E4.\n\n\uBD80\uC11C\uC9C4 \uD68C\uC218\uC120\uC744
    \uBC84\uB9AC\uACE0 \uACA8\uC6B0 \uBAB8\uC744 \uD53C\uD55C \uACF3\uC740 \uBC14\uAE65
    \uACE0\uB9AC\uC758 \uD53C\uB09C \uAD6C\uC5ED.\n\uADF8\uACF3\uC5D0\uB294 \uBD09\uC1C4\uB97C
    \uD53C\uD574 \uC0B4\uC544\uB0A8\uC740 \uC0DD\uC874\uC790 \uB2E4\uC12F \uBA85\uC774
    \uC788\uC5C8\uB2E4.\n\n\uACA9\uB0A9\uACE0\uC5D0\uB294 \uB9DD\uAC00\uC9C4 \uC7A5\uAC70\uB9AC
    \uD0C8\uCD9C \uD3EC\uB4DC\uAC00 \uD55C \uB300 \uB0A8\uC544 \uC788\uB2E4.\n\uBD80\uD488\uC744
    \uBAA8\uC544 \uACE0\uCE58\uBA74 \uBAA8\uB450 \uD568\uAED8 \uC774\uACF3\uC744
    \uB5A0\uB0A0 \uC218 \uC788\uB2E4.\n\uC154\uD2C0 \uD574\uCE58\uB85C \uC815\uAC70\uC7A5
    \uC548\uCABD\uC5D0 \uB4E4\uC5B4\uAC00, \uC0B4\uC544\uC11C \uB3CC\uC544\uC640\uB77C."
  _ending: "\uB9C8\uC9C0\uB9C9 \uBD80\uD488\uC774 \uB9DE\uBB3C\uB9AC\uC790, \uD3EC\uB4DC\uC758
    \uC5D4\uC9C4\uC774 \uB0AE\uAC8C \uC6B8\uB9AC\uAE30 \uC2DC\uC791\uD588\uB2E4.\n\n\uC13C\uD2F0\uB110\uC740
    \uB05D\uAE4C\uC9C0 \uACA9\uB0A9\uACE0 \uBB38\uC744 \uB2EB\uC73C\uB824 \uD588\uC9C0\uB9CC,\n\uBCF4\uC548
    \uC778\uC99D \uD0A4\uAC00 \uADF8 \uBA85\uB839\uC744 \uB36E\uC5B4\uC37C\uB2E4.\n\n\uBCFC\uD2B8,
    \uD55C, \uC138\uB77C, \uC624\uD1A0, \uBBF8\uB77C. \uADF8\uB9AC\uACE0 \uB2F9\uC2E0.\n\uC5EC\uC12F
    \uBA85\uC744 \uD0DC\uC6B4 \uD3EC\uB4DC\uAC00 \uC624\uB974\uBE44\uC2A4-9\uC744
    \uBC97\uC5B4\uB0AC\uB2E4.\n\n\uBA40\uC5B4\uC9C0\uB294 \uC815\uAC70\uC7A5\uC758
    \uBD88\uBE5B\uC744 \uBCF4\uBA70 \uB204\uAD70\uAC00 \uB9D0\uD588\uB2E4.\n\"\uB2E4\uC74C\uC5D4
    \uD654\uBB3C\uCE78 \uB9D0\uACE0, \uC9C4\uC9DC \uC9D1\uC73C\uB85C \uAC00\uC790.\""
  _credits: "ESCAPE from Space\n\n\uADF8\uB9BC  Kenney \xB7 knekko \xB7 Hyptosis
    \xB7 Jannax \xB7 ansimuz (CC0)\n\uC18C\uB9AC  Kenney (CC0)\n\uC74C\uC545  Fupi,
    Jason Shaw (CC0)\n\n\uD50C\uB808\uC774\uD574 \uC8FC\uC154\uC11C \uACE0\uB9D9\uC2B5\uB2C8\uB2E4.\n\uC5D4\uB529
    \uB4A4\uC5D0\uB3C4 \uB300\uAE30\uC2E4\uC5D0\uC11C \uACC4\uC18D\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
