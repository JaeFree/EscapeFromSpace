  m_Name: QuestDatabase
  m_EditorClassIdentifier: 
  _quests:
  - _id: Q01
    _title: "\uCCAB \uD68C\uC218"
    _npc: Workshop
    _chapter: 1
    _story: "\uB3C4\uCC29\uD558\uC790\uB9C8\uC790 \uACE0\uC0DD\uC774 \uB9CE\uC558\uC9C0.
      \uB09C \uC624\uD1A0, \uC5EC\uAE30 \uC815\uBE44\uB97C \uB9E1\uACE0 \uC788\uC5B4.\n\n\uACA9\uB0A9\uACE0\uC758
      \uC7A5\uAC70\uB9AC \uD3EC\uB4DC\uB97C \uACE0\uCE58\uB824\uBA74 \uC815\uAC70\uC7A5
      \uC548\uCABD\uC5D0\uC11C \uBB3C\uC790\uB97C \uAC00\uC838\uC640\uC57C \uD574.
      \uB808\uC774\uB4DC \uD3EC\uD0C8\uB85C \uB4E4\uC5B4\uAC00\uC11C, \uC77C\uB2E8
      \uC0B4\uC544\uC11C \uB3CC\uC544\uC640 \uBD10."
    _doneLine: "\uB3CC\uC544\uC654\uAD6C\uB098! \uADF8\uAC70\uBA74 \uCDA9\uBD84\uD574.
      \uC774\uAC78\uB85C \uC2DC\uC791\uD558\uC790."
    _requires: 
    _kind: 0
    _count: 1
    _robot: {fileID: 0}
    _namedId: 
    _zoneId: 
    _deliver: []
    _credits: 100
    _rewardItems:
    - _item: {fileID: 11400000, guid: d313b27335381a0409ba768205341510, type: 2}
      _count: 2
    _rewardNote: 
  - _id: Q02
    _title: "\uBCF4\uC548 \uB85C\uBD07 \uC2E4\uD0DC"
    _npc: Weapons
    _chapter: 1
    _story: "\uBCF4\uC548 \uB85C\uBD07\uC740 \uB0B4\uAC00 \uC124\uACC4\uD55C \uB188\uB4E4\uC774\uC57C.
      \uC9C0\uAE08\uC740 \uC13C\uD2F0\uB110\uC774 \uADF8\uB188\uB4E4\uC744 \uC950\uACE0
      \uC788\uC9C0.\n\n\uBA87 \uAE30\uB9CC \uBD80\uC234 \uBD10. \uAC10\uC744 \uC7A1\uC73C\uBA74
      \uB354 \uC88B\uC740 \uCD1D\uC744 \uB0B4\uC904\uAC8C."
    _doneLine: "\uC190\uC774 \uC880 \uB9DE\uB294\uAD70. \uC774\uC81C \uD384\uC2A4
      \uB77C\uC774\uD50C\uC744 \uD314\uC544 \uC8FC\uC9C0."
    _requires: 
    _kind: 1
    _count: 5
    _robot: {fileID: 0}
    _namedId: 
    _zoneId: 
    _deliver: []
    _credits: 200
    _rewardItems: []
    _rewardNote: "\uBB34\uAE30\uC0C1: \uD384\uC2A4 \uB77C\uC774\uD50C, \uB77C\uC774\uD50C
      \uC140"
  - _id: Q03
    _title: "\uC751\uAE09 \uCC98\uCE58"
    _npc: Medical
    _chapter: 1
    _story: "\uC758\uBB34\uC2E4\uC5D0\uC11C \uCC59\uACA8 \uB098\uC628 \uC57D\uC774
      \uAC70\uC758 \uBC14\uB2E5\uB0AC\uC5B4\uC694.\n\n\uBA54\uB514\uC824 \uC138 \uAC1C\uB9CC
      \uAD6C\uD574\uB2E4 \uC8FC\uC138\uC694. \uC0B0\uC18C \uCE94\uC744 \uB098\uB220
      \uB4DC\uB9B4\uAC8C\uC694."
    _doneLine: "\uACE0\uB9C8\uC6CC\uC694. \uC774\uC81C \uC0B0\uC18C \uCE94\uB3C4
      \uB4DC\uB9B4 \uC218 \uC788\uC5B4\uC694."
    _requires: 
    _kind: 5
    _count: 1
    _robot: {fileID: 0}
    _namedId: 
    _zoneId: 
    _deliver:
    - _item: {fileID: 11400000, guid: d313b27335381a0409ba768205341510, type: 2}
      _count: 3
    _credits: 0
    _rewardItems: []
    _rewardNote: "\uC758\uB8CC\uC0C1: \uC0B0\uC18C \uCE94"
  - _id: Q04
    _title: "\uC6B0\uC8FC\uBCF5 \uC218\uC120"
    _npc: Armor
    _chapter: 1
    _story: "\uD5EC\uBA67\uC744 \uB9CC\uB4E4\uB824\uB294\uB370 \uD68C\uB85C \uBD80\uD488\uC774
      \uBAA8\uC790\uB77C.\n\n\uB450 \uAC1C\uB9CC \uAD6C\uD574 \uC624\uBA74 \uD5EC\uBA67\uC744
      \uB9CC\uB4E4\uC5B4 \uD314\uAC8C."
    _doneLine: "\uC88B\uC544, \uC774\uAC78\uB85C \uD5EC\uBA67\uC744 \uB9CC\uB4E4
      \uC218 \uC788\uACA0\uC5B4."
    _requires: 
    _kind: 5
    _count: 1
    _robot: {fileID: 0}
    _namedId: 
    _zoneId: 
    _deliver:
    - _item: {fileID: 11400000, guid: c3a357234e1eff747bf6a30ca59083ee, type: 2}
      _count: 2
    _credits: 0
    _rewardItems: []
    _rewardNote: "\uBC29\uC5B4\uAD6C\uC0C1: 1\uB2E8\uACC4 \uD5EC\uBA67"
  - _id: Q05
    _title: "\uC804\uC6D0 \uCD94\uC801"
    _npc: Workshop
    _chapter: 2
    _story: "\uD3EC\uB4DC\uC5D0 \uB3D9\uB825\uC744 \uB123\uC73C\uB824\uBA74 \uAE30\uAD00\uC2E4
      \uBC30\uC120\uC744 \uBD10\uC57C \uD574.\n\n\uB3D9\uCABD \uAE30\uAD00\uC2E4\uC5D0
      \uB4E4\uC5B4\uAC14\uB2E4\uAC00 \uC0B4\uC544\uC11C \uB098\uC640 \uC918. \uB124\uAC00
      \uBCF8 \uAC83\uB9CC\uC73C\uB85C\uB3C4 \uC9C0\uB3C4\uAC00 \uC0DD\uACA8."
    _doneLine: "\uAE30\uAD00\uC2E4 \uBC30\uC120\uC774 \uC544\uC9C1 \uC0B4\uC544 \uC788\uAD70.
      \uC774\uC81C \uC120\uCCB4 \uD328\uB110\uC744 \uB9CC\uB4E4\uC5B4 \uC904 \uC218
      \uC788\uC5B4."
    _requires: 
    _kind: 6
    _count: 1
    _robot: {fileID: 0}
    _namedId: 
    _zoneId: Engine
    _deliver: []
    _credits: 0
    _rewardItems: []
    _rewardNote: "\uC81C\uC791\uC18C: \uC120\uCCB4 \uD328\uB110"
  - _id: Q06
    _title: "\uB179\uC2A8 \uC6A9\uC811\uACF5"
    _npc: Workshop
    _chapter: 2
    _story: "\uAE30\uAD00\uC2E4\uC5D0 '\uC6A9\uC811\uACF5 E-5'\uB77C\uB294 \uB188\uC774
      \uBC84\uD2F0\uACE0 \uC788\uC5B4. \uC6D0\uB798 \uC218\uB9AC \uB85C\uBD07\uC774\uC5C8\uB294\uB370,
      \uC13C\uD2F0\uB110\uC774 \uBB34\uAE30\uB97C \uB2EC\uC544 \uB1A8\uC9C0.\n\n\uADF8\uB188\uC744
      \uC4F0\uB7EC\uB728\uB9AC\uBA74 \uD50C\uB77C\uC988\uB9C8 \uC810\uD654\uAE30\uB97C
      \uAD6C\uD560 \uC218 \uC788\uC5B4. \uCD94\uC9C4 \uB178\uC990\uC5D0 \uAF2D \uD544\uC694\uD574."
    _doneLine: "\uC810\uD654\uAE30\uB2E4! \uC774\uAC78\uB85C \uCD94\uC9C4 \uB178\uC990\uC744
      \uB9CC\uB4E4 \uC218 \uC788\uC5B4."
    _requires: 
    _kind: 3
    _count: 1
    _robot: {fileID: 0}
    _namedId: E5
    _zoneId: 
    _deliver: []
    _credits: 0
    _rewardItems:
    - _item: {fileID: 11400000, guid: 595c3beca9ae44c44a392926ddc58c21, type: 2}
      _count: 1
    _rewardNote: "\uC81C\uC791\uC18C: \uCD94\uC9C4 \uB178\uC990"
  - _id: Q07
    _title: "\uACFC\uBD80\uD558"
    _npc: Weapons
    _chapter: 2
    _story: "\uB0A8\uB3D9\uCABD \uB3D9\uB825 \uAD6C\uC5ED\uC758 '\uACFC\uBD80\uD558
      P-X'\uAC00 \uC804\uB825\uB9DD\uC744 \uBD99\uB4E4\uACE0 \uC788\uC5B4.\n\n\uADF8\uB188\uC744
      \uC4F0\uB7EC\uB728\uB9AC\uBA74 \uB3D9\uB825 \uC140\uC744 \uD558\uB098 \uAC74\uC9C8
      \uC218 \uC788\uC744 \uAC70\uC57C. \uBD80\uCC29\uBB3C\uB3C4 \uD480\uC5B4 \uC8FC\uC9C0."
    _doneLine: "\uB3D9\uB825 \uC140\uC774\uAD70. \uC624\uD1A0\uAC00 \uC88B\uC544\uD558\uACA0\uC5B4.
      \uBD80\uCC29\uBB3C 1\uB2E8\uACC4\uB97C \uD314\uC544 \uC8FC\uC9C0."
    _requires: Q05
    _kind: 3
    _count: 1
    _robot: {fileID: 0}
    _namedId: PX
    _zoneId: 
    _deliver: []
    _credits: 0
    _rewardItems:
    - _item: {fileID: 11400000, guid: 847464edc15e1f046bdfa2fece8ee86d, type: 2}
      _count: 1
    _rewardNote: "\uBB34\uAE30\uC0C1: \uBD80\uCC29\uBB3C 1\uB2E8\uACC4"
  - _id: Q08
    _title: "\uC5F0\uC0AC \uB300\uC751"
    _npc: Weapons
    _chapter: 2
    _story: "AR \uB85C\uBD07\uC758 \uC5F0\uC0AC\uB294 \uC26C\uB294 1.5\uCD08\uAC00
      \uD2C8\uC774\uC57C.\n\n\uC5EC\uB35F \uAE30\uB97C \uBD80\uC218\uACE0 \uC640.
      \uC0F7\uAC74\uC744 \uB0B4\uC904 \uB9CC\uD558\uB2E4\uACE0 \uC778\uC815\uD558\uC9C0."
    _doneLine: "\uC88B\uC544. \uD50C\uB77C\uC988\uB9C8 \uC2A4\uCE90\uD130\uB97C \uD314\uC544
      \uC8FC\uC9C0."
    _requires: 
    _kind: 2
    _count: 8
    _robot: {fileID: 11400000, guid: 64f7dbceefb9afa42a5044f6f24bcd44, type: 2}
    _namedId: 
    _zoneId: 
    _deliver: []
    _credits: 0
    _rewardItems: []
    _rewardNote: "\uBB34\uAE30\uC0C1: \uD50C\uB77C\uC988\uB9C8 \uC2A4\uCE90\uD130,
      \uD50C\uB77C\uC988\uB9C8 \uCEA1\uC290"
  - _id: Q09
    _title: "\uB450\uAEBC\uC6B4 \uC7A5\uAC11"
    _npc: Armor
    _chapter: 2
    _story: "2\uB2E8\uACC4 \uBC29\uD0C4\uBCF5\uC5D4 \uAC15\uD654 \uD569\uAE08\uC774
      \uB9CE\uC774 \uB4E4\uC5B4\uAC00.\n\n\uC5F4 \uAC1C\uB9CC \uBAA8\uC544 \uC918."
    _doneLine: "\uD2BC\uD2BC\uD55C \uAC78\uB85C \uB9CC\uB4E4\uC5B4 \uB1A8\uC5B4.
      2\uB2E8\uACC4 \uC7A5\uBE44\uB97C \uD314\uAC8C."
    _requires: 
    _kind: 5
    _count: 1
    _robot: {fileID: 0}
    _namedId: 
    _zoneId: 
    _deliver:
    - _item: {fileID: 11400000, guid: 775169d682579324aa2781d5dd5afb2f, type: 2}
      _count: 10
    _credits: 0
    _rewardItems: []
    _rewardNote: "\uBC29\uC5B4\uAD6C\uC0C1: 2\uB2E8\uACC4 \uBC29\uD0C4\uBCF5\xB7\uD5EC\uBA67"
  - _id: Q10
    _title: "\uC9D0\uAFBC"
    _npc: BlackMarket
    _chapter: 2
    _story: "\uD654\uBB3C\uCE78\uC758 '\uC9D0\uAFBC K-7' \uC54C\uC544? \uB0B4 \uBB3C\uAC74\uC744
      \uC2E4\uC740 \uCEE8\uD14C\uC774\uB108\uB97C \uADF8\uB188\uC774 \uC9C0\uD0A4\uACE0
      \uC788\uC5B4.\n\n\uCE58\uC6CC \uC8FC\uBA74 \uB109\uB109\uD788 \uCCD0 \uC904\uAC8C."
    _doneLine: "\uAE54\uB054\uD558\uB124. \uC57D\uC18D\uD55C \uB3C8\uC774\uC57C."
    _requires: Q02
    _kind: 3
    _count: 1
    _robot: {fileID: 0}
    _namedId: K7
    _zoneId: 
    _deliver: []
    _credits: 500
    _rewardItems: []
    _rewardNote: 
  - _id: Q11
    _title: "\uC0DD\uC874\uC790 \uAE30\uB85D"
    _npc: Medical
    _chapter: 3
    _story: "\uC11C\uCABD \uCE68\uC2E4\uC5D0 \uB0A8\uC740 \uC0AC\uB78C\uB4E4\uC758
      \uAE30\uB85D\uC744 \uCC3E\uACE0 \uC2F6\uC5B4\uC694. \uADF8\uB7F0\uB370 '\uC57C\uAC04
      \uACBD\uBE44 N-3'\uAC00 \uC9C0\uD0A4\uACE0 \uC788\uC5B4\uC694.\n\n\uC13C\uD2F0\uB110\uC774
      \uC65C \uC815\uAC70\uC7A5\uC744 \uBD09\uC1C4\uD588\uB294\uC9C0, \uAE30\uB85D\uC5D0
      \uB0A8\uC544 \uC788\uC744\uC9C0\uB3C4 \uBAB0\uB77C\uC694."
    _doneLine: "\uAE30\uB85D\uC5D0 \uC801\uD600 \uC788\uC5C8\uC5B4\uC694\u2026 \uC13C\uD2F0\uB110\uC740
      \uC5F0\uAD6C\uC18C\uC758 \uBB34\uC5B8\uAC00\uB97C '\uACA9\uB9AC'\uD558\uB824
      \uD588\uB300\uC694. \uC774\uC81C \uBA54\uB514\uD0B7\uC744 \uB4DC\uB9B4\uAC8C\uC694."
    _requires: Q05
    _kind: 3
    _count: 1
    _robot: {fileID: 0}
    _namedId: N3
    _zoneId: 
    _deliver: []
    _credits: 0
    _rewardItems: []
    _rewardNote: "\uC758\uB8CC\uC0C1: \uBA54\uB514\uD0B7"
  - _id: Q12
    _title: "\uC18C\uB3C5"
    _npc: Medical
    _chapter: 3
    _story: "\uC758\uBB34\uC2E4\uC758 '\uC18C\uB3C5\uAE30 M-1'\uC774 \uC544\uC9C1
      \uC18C\uB3C5 \uBA85\uB839\uC744 \uB530\uB974\uACE0 \uC788\uC5B4\uC694. \uB2E4\uAC00\uAC00\uB294
      \uAC74 \uBB50\uB4E0 \uC3F4 \uBC84\uB824\uC694.\n\n\uADF8 \uC548\uCABD \uCC3D\uACE0\uC5D0
      \uC0B0\uC18C \uC7AC\uC0DD\uAE30\uAC00 \uC788\uC5B4\uC694. \uD3EC\uB4DC\uC5D0
      \uAF2D \uD544\uC694\uD574\uC694."
    _doneLine: "\uC0B0\uC18C \uC7AC\uC0DD\uAE30\uC608\uC694. \uC624\uD1A0\uC5D0\uAC8C
      \uAC00\uC838\uAC00 \uC8FC\uC138\uC694."
    _requires: 
    _kind: 3
    _count: 1
    _robot: {fileID: 0}
    _namedId: M1
    _zoneId: 
    _deliver: []
    _credits: 0
    _rewardItems:
    - _item: {fileID: 11400000, guid: 58ea9110cc3e5b5459b2c09bfc7f32d4, type: 2}
      _count: 1
    _rewardNote: 
  - _id: Q13
    _title: "\uC5F0\uAD6C \uC0D8\uD50C"
    _npc: Workshop
    _chapter: 3
    _story: "\uC5F0\uAD6C\uC18C \uC0AC\uB78C\uB4E4\uC774 \uC4F0\uB358 \uD000\uD140
      \uCF54\uC5B4\uB85C \uACE0\uCD9C\uB825 \uD0C4\uC57D\uACFC \uB3D9\uB825 \uC140\uC744
      \uB9CC\uB4E4 \uC218 \uC788\uC5B4.\n\n\uC138 \uAC1C\uB9CC \uBAA8\uC544 \uC640
      \uC918."
    _doneLine: "\uC774\uC81C \uACE0\uCD9C\uB825 \uD0C4\uC57D\uACFC \uB3D9\uB825 \uC140\uC744
      \uB9CC\uB4E4 \uC218 \uC788\uC5B4."
    _requires: Q06
    _kind: 5
    _count: 1
    _robot: {fileID: 0}
    _namedId: 
    _zoneId: 
    _deliver:
    - _item: {fileID: 11400000, guid: 90fe216fd7cb176478376393f8da71d9, type: 2}
      _count: 3
    _credits: 0
    _rewardItems: []
    _rewardNote: "\uC81C\uC791\uC18C: \uACE0\uCD9C\uB825 \uD0C4\uC57D, \uB3D9\uB825
      \uC140"
  - _id: Q14
    _title: "\uAC10\uC2DC\uC790"
    _npc: Weapons
    _chapter: 3
    _story: "\uC5F0\uAD6C\uC18C\uC758 '\uAC10\uC2DC\uC790 R-9'\uAC00 \uD56D\uBC95
      \uCF54\uC5B4\uB97C \uD488\uACE0 \uC788\uC5B4. \uC13C\uD2F0\uB110\uC774 \uACA9\uB9AC\uD558\uB824\uB358
      \uC5F0\uAD6C \uB370\uC774\uD130\uC640 \uAC19\uC774 \uB9D0\uC774\uC57C.\n\n\uD56D\uBC95
      \uCF54\uC5B4 \uC5C6\uC774 \uD3EC\uB4DC\uB294 \uC5B4\uB514\uB85C\uB3C4 \uBABB
      \uAC00."
    _doneLine: "\uD56D\uBC95 \uCF54\uC5B4\uB2E4. \uB370\uC774\uD130\uB294\u2026 \uC9C0\uC6CC\uC838
      \uC788\uAD70. \uC13C\uD2F0\uB110\uC774 \uC9C0\uC6B4 \uAC70\uC57C."
    _requires: Q13
    _kind: 3
    _count: 1
    _robot: {fileID: 0}
    _namedId: R9
    _zoneId: 
    _deliver: []
    _credits: 0
    _rewardItems:
    - _item: {fileID: 11400000, guid: 8d00b427e4334694c8a441aaaa7117e4, type: 2}
      _count: 1
    _rewardNote: 
  - _id: Q15
    _title: "\uC815\uBC00 \uC0AC\uACA9"
    _npc: Weapons
    _chapter: 3
    _story: "\uC800\uACA9 \uB85C\uBD07 \uC5EC\uC12F \uAE30. \uC870\uC900\uC120\uC744
      \uBCF4\uACE0 \uAD6C\uB974\uB294 \uBC95\uC744 \uC775\uD788\uBA74 \uD560 \uC218
      \uC788\uC5B4.\n\n\uD574\uB0B4\uBA74 \uB124\uBDF8\uB77C-7\uACFC \uACE0\uAE09
      \uBD80\uCC29\uBB3C\uC744 \uB0B4\uC8FC\uC9C0."
    _doneLine: "\uD6CC\uB96D\uD574. \uB124\uBDF8\uB77C-7\uACFC \uBD80\uCC29\uBB3C
      2\uB2E8\uACC4\uB97C \uD314\uC544 \uC8FC\uC9C0."
    _requires: 
    _kind: 2
    _count: 6
    _robot: {fileID: 11400000, guid: 0ef7841e6712bf240a8436f6fff940f5, type: 2}
    _namedId: 
